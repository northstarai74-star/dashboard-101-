generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum-like string columns (kept as String for portability).
// ROLE: ADMIN | MEMBER
// SERVICE: AI_VOICE | WEB_DEV | UNASSIGNED
// STAGE: NEW | CONTACTED | QUALIFIED | PROPOSAL | WON | LOST
// SOURCE: META_DM | META_COMMENT | META_LEAD_AD | MANUAL
// AGENT: AI | HUMAN
// PROVIDER: META | CLAUDE | HIGGSFIELD
// KEY STATUS: ACTIVE | DISABLED | RATE_LIMITED

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("MEMBER")
  title        String?
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())

  leads      Lead[]
  activities Activity[]
  rules      AssignmentRule[]
  creatives  Creative[]
  todos      Todo[]
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  instagramHandle String?
  igUserId        String?  @unique
  company         String?
  notes           String?
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now())

  leads         Lead[]
  conversations Conversation[]
  comments      Comment[]
}

model Lead {
  id              String   @id @default(cuid())
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title           String
  source          String   @default("MANUAL")
  service         String   @default("UNASSIGNED")
  stage           String   @default("NEW")
  score           Int      @default(0)
  aiSummary       String?
  assignedAgent   String   @default("HUMAN")
  assignedUserId  String?
  assignedUser    User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  estimatedValue  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals       Deal[]
  activities  Activity[]
  comments    Comment[]
  enquiries   Enquiry[]

  @@index([service])
  @@index([stage])
  @@index([createdAt])
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service   String
  amount    Float
  status    String    @default("PAID") // PENDING | PAID
  paidAt    DateTime  @default(now())

  @@index([paidAt])
}

model Conversation {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  platform    String    @default("INSTAGRAM")
  externalId  String?   @unique
  unread      Int       @default(0)
  lastMessageAt DateTime @default(now())
  messages    Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?      @unique
  direction      String       // IN | OUT
  text           String
  byAi           Boolean      @default(false) // sent automatically by the AI agent
  sentAt         DateTime     @default(now())

  @@index([conversationId, sentAt])
}

model Comment {
  id         String   @id @default(cuid())
  externalId String?  @unique
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  postRef    String?
  author     String
  text       String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  externalId String? @unique
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  formName  String?
  name      String?
  email     String?
  phone     String?
  message   String?
  raw       String?  // JSON payload
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id             String    @id @default(cuid())
  provider       String
  label          String
  encryptedValue String
  keyHint        String    // last 4 chars for display
  status         String    @default("ACTIVE")
  priority       Int       @default(0)
  usageCount     Int       @default(0)
  lastUsedAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([provider, status])
}

model MetaConnection {
  id            String   @id @default("singleton")
  appId         String?
  appSecretEnc  String?
  pageId        String?
  igBusinessId  String?
  accessTokenEnc String?
  verifyToken   String
  connected     Boolean  @default(false)
  lastSyncAt    DateTime?
  updatedAt     DateTime @updatedAt
}

// One row per external channel (WHATSAPP, LINKEDIN, YOUTUBE, EMAIL, WEBSITE, FINANCE).
// `config` holds non-secret fields as JSON; `secretsEnc` holds the encrypted secret fields.
model Connection {
  id           String    @id // channel slug, see src/lib/connections.ts
  config       String    @default("{}")
  secretsEnc   String?
  status       String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | ERROR
  accountLabel String?
  lastCheckedAt DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   // CREATED | ASSIGNED | STAGE | NOTE | AI | CONVERTED
  text      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model AssignmentRule {
  id      String  @id @default(cuid())
  service String  @unique
  agent   String  @default("HUMAN") // AI | HUMAN
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Setting {
  key   String @id
  value String
}

// Login throttling shared by every server instance (serverless functions don't share memory).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Daily channel metrics that have no native data in this app (WhatsApp, YouTube, LinkedIn, email, website, ...).
// Filled by hand on the Analytics page or pushed by automations to POST /api/metrics/ingest.
// One row per channel + metric + day + source; re-sending the same day overwrites the value.
model MetricEntry {
  id        String   @id @default(cuid())
  channel   String   // see src/lib/analytics.ts CHANNELS
  metric    String   // see src/lib/analytics.ts CHANNELS
  date      DateTime // UTC midnight of the day the value belongs to
  value     Float
  source    String   @default("manual") // manual | api:<name>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, metric, date, source])
  @@index([channel, metric, date])
}

// Business costs. Revenue comes from Deal; profit = revenue - expenses.
model Expense {
  id        String   @id @default(cuid())
  label     String
  category  String   @default("OTHER") // TOOLS | ADS | PAYROLL | OPERATIONS | OTHER
  amount    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([date])
}

// A saved council analysis of an issue, run against the business data at the time it was asked.
model DebateResult {
  id        String   @id @default(cuid())
  question  String
  mode      String   @default("offline") // live | offline
  verdict   String
  actions   Json
  advisors  Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A task for one person. userId null = an owner-level task from before accounts existed (admins only).
model Todo {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([done, createdAt])
  @@index([userId])
}

// Higgsfield image generations. STATUS: queued | in_progress | completed | failed | nsfw
model Creative {
  id        String   @id @default(cuid())
  prompt    String
  aspect    String   @default("1:1")
  requestId String?  @unique
  apiKeyId  String?  // the key that submitted the job; Higgsfield requests are scoped to that account
  status    String   @default("queued")
  imageUrl  String?
  error     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
