# PostgreSQL (Supabase, Neon, local docker, ...). On Supabase use the *Session pooler* string (port 5432)
# from Project Settings → Database → Connection string; it works for both the app and migrations on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Signs login sessions — use a long random string
SESSION_SECRET="change-me-to-a-long-random-string"
# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# Admin sign-in. On an empty database the first sign-in with ADMIN_PASSWORD creates the admin (no seed needed);
# `npm run db:seed` instead loads demo data. Any length works, but use something hard to guess.
ADMIN_EMAIL="admin@vanita.local"
ADMIN_PASSWORD="ChangeMe123!"
# Optional: the team access code people enter on the sign-in page ("Join as team member") to create their own account.
# Min 8 characters. You can also set or change it in Settings (that one wins). Leave empty to keep sign-up closed.
TEAM_SIGNUP_CODE=""
# Public https base URL when tunnelling (ngrok / cloudflared) — used to display the webhook URL
APP_URL="http://localhost:3000"
# Protects the scheduled Meta sync (GET /api/meta/sync). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET="change-me-to-another-long-random-string"
